# Copy to .env.local for `npm run dev`. Never commit real values.
# `make web-up` runs everything in Docker and sets these itself.

# Public origin of the site (canonical URLs, sitemap, links in emails). Use https in production:
# the session cookie is only marked Secure for https sites.
SITE_URL=http://localhost:5003

# Postgres. Locally this is the `web-db` container (host port 5018).
DATABASE_URL=postgres://web:web-local-only@localhost:5018/web
# Apply SQL migrations when the server starts. Locally run `npm run db:migrate` instead.
RUN_MIGRATIONS=false

# SMTP. Locally this is Mailpit (host port 5016); read the mail at http://localhost:5017.
SMTP_HOST=localhost
SMTP_PORT=5016
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="Alex Projects <no-reply@localhost>"
