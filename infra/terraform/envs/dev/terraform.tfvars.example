# environments that CI creates.
# admin_object_ids = ["00000000-0000-0000-0000-000000000000"]

# location       = "eastus"
# system_vm_size = "Standard_B2s"
# app_vm_size    = "Standard_B2ms"
# app_max_count  = 2
